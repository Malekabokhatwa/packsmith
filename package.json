{
  "name": "packsmith",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source, bring-your-own-key Minecraft modpack agent.",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "e2e": "electron-vite build && xvfb-run -a -s '-screen 0 1440x900x24' playwright test",
    "dist": "electron-vite build && electron-builder --linux AppImage --publish never"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tabs": "1.2.1",
    "json5": "2.2.3",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "homepage": "https://github.com/Malekabokhatwa/packsmith",
  "author": {
    "name": "Malek"
  },
  "build": {
    "appId": "dev.packsmith.app",
    "productName": "packsmith",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "artifactName": "packsmith-${version}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "synopsis": "Build and fix Minecraft modpacks by describing them",
      "executableName": "packsmith",
      "syncDesktopName": true
    }
  },
  "desktopName": "packsmith.desktop"
}
